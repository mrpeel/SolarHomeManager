# =============================================================================
# SolarHomeManager `.env` — SECRETS & HOME IDENTITY (git-ignored, per-machine).
# Rule: every key lives in exactly ONE file.
#   .env (this file) .... secrets, home identity, and household setup:
#                          Tesla tokens, TESLA_VIN, Deco password, home
#                          coordinates, LAN IPs, room names (ZONE_*_NAME),
#                          network presence targets (PRESENCE_TARGETS_JSON).
#                          NEVER committed. (Rare scenario-simulation knobs are
#                          documented at the bottom; not part of a deployment.)
#   config.json .......... pure behavior only (thresholds, timings, bands,
#                          damper minima, priority weights, occupied-hour
#                          windows, ROLLOUT_STAGE, DRY_RUN_*, MOCK_* master
#                          switches). Safe to commit. `.env` NEVER overrides
#                          behavior — it only fills in WHO/WHERE, never HOW.
# =============================================================================

# --- Tesla Fleet API credentials (from docs/tesla_api_setup.md) ---
# (API base URL / region lives in config.json -> TESLA_API_BASE_URL.)
TESLA_VIN=5YJ3XXXXXXXXXXXXX
TESLA_CLIENT_ID=YOUR_TESLA_CLIENT_ID
TESLA_CLIENT_SECRET=YOUR_TESLA_CLIENT_SECRET
TESLA_API_TOKEN=YOUR_TESLA_API_ACCESS_TOKEN
TESLA_REFRESH_TOKEN=YOUR_TESLA_REFRESH_TOKEN

# --- Home network: LAN IPs of local devices (example values shown) ---
FRONIUS_IP=192.168.1.63
AIRTOUCH_IP=192.168.1.30
AIRTOUCH_PORT=9005
TESLA_WALL_CONNECTOR_IP=192.168.1.60
DECO_MAIN_IP=192.168.1.1

# (No Deco password needed: the BE65's AES-encrypted web API has no usable
#  local login, so presence detection runs on ping + DHCP reservations and
#  never logs into the Deco. Use the Deco app as the client list.)

# --- Room names, one per AirTouch zone index (shown in logs; use whatever
#     names your household uses — these never leave this machine).
#     (Example values below are fictional.) ---
ZONE_0_NAME=Bedroom 1
ZONE_1_NAME=Living Room
ZONE_2_NAME=Bedroom 2
ZONE_3_NAME=Bedroom 3
ZONE_4_NAME=Study

# --- Network presence targets (JSON list; labels/MACs/IPs of household
#     laptops — identifying, so they live here, not in config.json).
#     IPs should be DHCP reservations on the Deco; turn OFF private/
#     randomized Wi-Fi MAC for your home SSID on each laptop. ---
PRESENCE_TARGETS_JSON=[{"label": "Study-Laptop", "zone": "4", "macs": [], "ips": ["192.168.1.50"]}]

# --- Home coordinates, ~1 km precision example only (kept out of git for
#     privacy; replace with your home coordinates. Used for daylight + weather) ---
LATITUDE=-33.87
LONGITUDE=151.21

# --- Optional scenario overrides (advanced/dev only: normally leave unset) ---
# The MOCK_* master switches in config.json already fake the hardware with
# sensible defaults. These extra knobs let you script a specific "what if"
# (e.g. MOCK_VEHICLE_SOC=40 to rehearse a low-battery day) by exporting them
# in your shell before running — they do NOT belong in a deployed .env file,
# and are ignored unless the matching MOCK_* switch in config.json is true:
#   MOCK_VEHICLE_HOME / MOCK_VEHICLE_PLUGGED / MOCK_VEHICLE_SOC /
#   MOCK_VEHICLE_CHARGE_LIMIT / MOCK_WALL_CONNECTOR_CONNECTED /
#   MOCK_WALL_CONNECTOR_CONTACTOR / MOCK_WALL_CONNECTOR_CURRENT /
#   MOCK_OUTDOOR_TEMP_C / MOCK_CLOUD_COVER_PCT / MOCK_FORECAST_MAX_C /
#   MOCK_FORECAST_MIN_C
